class Jumper
{
  int myX, myY;
  Jumper()
  {
  myX = 250;
  myY = 250;
  }
  void jump()
  {
    myX = (int)(Math.random()*500);
  myY = (int)(Math.random()*500);
  }
  void show()
  {
    ellipse(myX, myY, 50,50);
  }
}// end class jumper

Walker Fred;
Jumper bob;
Walker [] home;
void setup(){
  size(1000,1000);
  bob = new Jumper();
  Fred = new Walker();
  home = new Walker[1000];
  for(int i = 0; i < home.length; i++)
    home[i] = new Walker();
}

void draw(){
  background(0,0,0);
  for ( int i = 0; i < home.length; i++)
  {
    home[i].Walk();
    home[i].show();
  }
  bob.jump();
  Fred.Walk();
  bob.show();
  Fred.show();
  
}





class Walker
{
  int myX, myY;
  Walker()
  {
  myX = 750;
  myY = 250;
  }
  void Walk()
  {
    myX = myX + (int)(Math.random()*3)-1;
    myY = myY + (int)(Math.random()*3)-1;
  }
  void show()
  {
    ellipse(myX, myY, 50,50);
  }
}// end class walker
